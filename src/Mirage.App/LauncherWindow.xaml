<Window x:Class="Mirage.App.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Mirage" Width="800" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="Transparent" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="-1" CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SectionPill" TargetType="RadioButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="17" Padding="14,7" Margin="0,0,6,0" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectionBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#40FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Background="{StaticResource GlassTint}" BorderThickness="1" CornerRadius="8" AllowDrop="True" RenderTransformOrigin="0.5,0">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#40FFFFFF" Offset="0" />
                <GradientStop Color="#14FFFFFF" Offset="0.5" />
                <GradientStop Color="#307C8CFF" Offset="1" />
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale" />
                <TranslateTransform x:Name="RootShift" />
            </TransformGroup>
        </Border.RenderTransform>
        <Grid>
            <!-- soft sheen across the top-left of the glass -->
            <Border Background="{StaticResource Sheen}" CornerRadius="8" IsHitTestVisible="False" />
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Search row -->
                <Grid Grid.Row="0" Margin="20,16,16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource AccentGradient}" VerticalAlignment="Center">
                        <TextBlock x:Name="ModeGlyph" Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Grid Grid.Column="1" Margin="14,0,10,0">
                        <TextBlock x:Name="Placeholder" Text="Search apps, files, or type ? to ask AI" Foreground="{StaticResource FaintTextBrush}"
                                   FontSize="21" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBox x:Name="Query" FontSize="21" Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource AccentBrush}"
                                 SelectionBrush="{StaticResource AccentBrush}" Background="Transparent" BorderThickness="0" Padding="0"
                                 VerticalAlignment="Center" FontFamily="{StaticResource UiFont}" />
                    </Grid>
                    <Border x:Name="ModeChip" Grid.Column="2" CornerRadius="8" Padding="10,4" Background="{StaticResource ChipBrush}"
                            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="ModeText" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <!-- Selection preview (selection hotkey) -->
                <Border x:Name="SelectionBox" Grid.Row="1" Margin="20,0,20,12" CornerRadius="10" Padding="12,8" Background="#0FFFFFFF"
                        BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" Visibility="Collapsed">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource AccentBrush}" FontSize="13" Margin="0,2,10,0" />
                        <TextBlock x:Name="SelectionText" Foreground="{StaticResource SubtleTextBrush}" FontSize="12.5" TextTrimming="CharacterEllipsis" MaxHeight="36" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>

                <!-- Sections: click, or swipe sideways with two fingers -->
                <StackPanel x:Name="SectionBar" Grid.Row="2" Orientation="Horizontal" Margin="16,0,16,12" />

                <!-- Results + action panel -->
                <Grid Grid.Row="3" x:Name="Body">
                    <Rectangle Height="1" VerticalAlignment="Top" Fill="{StaticResource HairlineBrush}" />
                    <ListBox x:Name="Results" Margin="8,8,8,4" Background="Transparent" BorderThickness="0" MaxHeight="486"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"
                             VirtualizingPanel.IsVirtualizing="False" Focusable="False" KeyboardNavigation.TabNavigation="None">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" CornerRadius="10" Padding="10,7" Margin="0,1" Background="Transparent">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#0DFFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectionBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="38">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="9" Background="{Binding Tint, Converter={StaticResource TintConverter}}"
                                            Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVis}}">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Image Width="32" Height="32" Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="14.5" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                                            <TextBlock Text="&#xE718;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{StaticResource AccentBrush}" Margin="8,2,0,0"
                                                       VerticalAlignment="Center" Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource FaintTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Margin="0,1,0,0" Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="6" Padding="8,2" Background="{StaticResource ChipBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Badge}" Foreground="{StaticResource SubtleTextBrush}" FontSize="11.5" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Tile home: big glass cards for touchpad and mouse -->
                    <ListBox x:Name="Tiles" Margin="10,10,10,6" Background="Transparent" BorderThickness="0" MaxHeight="430" Visibility="Collapsed"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" ScrollViewer.PanningMode="VerticalOnly"
                             VirtualizingPanel.IsVirtualizing="False" Focusable="False" KeyboardNavigation.TabNavigation="None">
                        <ListBox.RenderTransform>
                            <TranslateTransform x:Name="TilesShift" />
                        </ListBox.RenderTransform>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Width="144" Height="126" Margin="4" CornerRadius="16" Background="#0BFFFFFF"
                                                    BorderBrush="#18FFFFFF" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform x:Name="Lift" />
                                                </Border.RenderTransform>
                                                <Grid>
                                                    <Border x:Name="Glow" CornerRadius="16" Opacity="0" Background="{StaticResource SelectionBrush}" />
                                                    <ContentPresenter />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2" />
                                                                <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#40FFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#70B4AAFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,14,10,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid HorizontalAlignment="Center">
                                        <Border Width="46" Height="46" CornerRadius="13" Background="{Binding Tint, Converter={StaticResource TintConverter}}"
                                                Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVis}}">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="19" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Image Width="44" Height="44" Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                                        <Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource AccentGradient}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="0,-5,-7,0" Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="&#xE718;" FontFamily="{StaticResource IconFont}" FontSize="8" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="12.5" FontWeight="SemiBold" TextAlignment="Center"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" />
                                        <TextBlock Text="{Binding Badge}" Foreground="{StaticResource FaintTextBrush}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Drop target overlay -->
                    <Border x:Name="DropOverlay" Margin="10" CornerRadius="14" BorderThickness="1.5" Background="#337C8CFF" Visibility="Collapsed" IsHitTestVisible="False">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#C08EA2FF" Offset="0" />
                                <GradientStop Color="#C0C084FC" Offset="0.5" />
                                <GradientStop Color="#C05EEAD4" Offset="1" />
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="30" Foreground="White" HorizontalAlignment="Center" />
                            <TextBlock x:Name="DropText" Text="Drop to see what Mirage can do with it" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center" />
                            <TextBlock Text="Or drop it straight onto a workspace, an AI or Notes" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Actions panel (Tab or right-click) -->
                    <Border x:Name="ActionPanel" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="320" Margin="0,0,14,10"
                            CornerRadius="12" Padding="6" Background="#F5161722" BorderBrush="#33FFFFFF" BorderThickness="1" Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.5" Color="Black" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock x:Name="ActionTitle" Foreground="{StaticResource FaintTextBrush}" FontSize="11.5" Margin="10,6,10,6" TextTrimming="CharacterEllipsis" />
                            <ListBox x:Name="ActionList" Background="Transparent" BorderThickness="0" Focusable="False" MaxHeight="340"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" CornerRadius="8" Padding="10,7" Background="Transparent">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#0DFFFFFF" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectionBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="13" Width="22"
                                                       Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Shortcut}" FontSize="11" Foreground="{StaticResource FaintTextBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="13" Margin="6,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Footer -->
                <Border Grid.Row="4" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Background="#0AFFFFFF" Padding="18,9" CornerRadius="0,0,8,8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Mirage" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock x:Name="Status" Margin="12,0,0,0" FontSize="12" Foreground="{StaticResource FaintTextBrush}" />
                        </StackPanel>
                        <Button x:Name="SettingsButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="8,2" Margin="12,0,0,0" ToolTip="Settings" Focusable="False">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                        </Button>
                        <TextBlock x:Name="Hints" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource FaintTextBrush}"
                                   Text="↵ Open    Tab Actions    Esc Close" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
