<Window x:Class="Mirage.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Mirage settings" Width="940" Height="680" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="Transparent" FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="-1" CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="Root" Background="{StaticResource GlassTint}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Background="#14000000" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="14,14,14,16">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,2,0,22">
                        <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource AccentGradient}">
                            <TextBlock Text="M" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Mirage" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" x:Name="VersionText" Style="{StaticResource Hint}" Margin="8,0" />
                    <StackPanel shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" GroupName="nav" IsChecked="True" Tag="General">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" Margin="0,2,12,0" />
                                <TextBlock Text="General" /></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavLibrary" Style="{StaticResource NavItem}" GroupName="nav" Tag="Library">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" FontFamily="{StaticResource IconFont}" Margin="0,2,12,0" />
                                <TextBlock Text="Workflows" /></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavAgents" Style="{StaticResource NavItem}" GroupName="nav" Tag="Agents">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE99A;" FontFamily="{StaticResource IconFont}" Margin="0,2,12,0" />
                                <TextBlock Text="AI agents" /></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" GroupName="nav" Tag="About">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" Margin="0,2,12,0" />
                                <TextBlock Text="About" /></StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Close button -->
            <Button Grid.Column="1" x:Name="CloseButton" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,10,0" Width="36" Height="30"
                    Style="{StaticResource GhostButton}" Padding="0" shell:WindowChrome.IsHitTestVisibleInChrome="True" Panel.ZIndex="5">
                <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="11" />
            </Button>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,44,0,0">
                <Grid Margin="34,0,34,30">
                    <!-- General -->
                    <StackPanel x:Name="PageGeneral">
                        <TextBlock Text="General" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Open Mirage" Style="{StaticResource Label}" /><TextBlock Text="Click the box and press the keys you want" Style="{StaticResource Hint}" /></StackPanel>
                                    <TextBox x:Name="HotkeyBox" Grid.Column="1" Style="{StaticResource GlassTextBox}" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Hand" />
                                </Grid>
                                <Grid Margin="0,10,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Quick actions on selected text" Style="{StaticResource Label}" /><TextBlock Text="Select text in any app, then press this" Style="{StaticResource Hint}" /></StackPanel>
                                    <TextBox x:Name="SelectionHotkeyBox" Grid.Column="1" Style="{StaticResource GlassTextBox}" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Hand" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="StartupCheck" Style="{StaticResource Switch}" Content="Start Mirage when I sign in" />
                                <CheckBox x:Name="HideCheck" Style="{StaticResource Switch}" Content="Hide when I click away" />
                                <CheckBox x:Name="FilesCheck" Style="{StaticResource Switch}" Content="Show matching files in search" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Glass" Style="{StaticResource Label}" /><TextBlock Text="Acrylic blur, Mica, or solid for older PCs" Style="{StaticResource Hint}" /></StackPanel>
                                    <ComboBox x:Name="GlassCombo" Grid.Column="1" Style="{StaticResource GlassCombo}" />
                                </Grid>
                                <Grid Margin="0,10,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Web search" Style="{StaticResource Label}" />
                                    <ComboBox x:Name="EngineCombo" Grid.Column="1" Style="{StaticResource GlassCombo}" />
                                </Grid>
                                <Grid Margin="0,10,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Default AI" Style="{StaticResource Label}" /><TextBlock Text="Used by ? questions and text actions" Style="{StaticResource Hint}" /></StackPanel>
                                    <ComboBox x:Name="AiCombo" Grid.Column="1" Style="{StaticResource GlassCombo}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="ClipCheck" Style="{StaticResource Switch}" Content="Keep clipboard history (text only, skips password managers)" />
                                <CheckBox x:Name="PersistClipCheck" Style="{StaticResource Switch}" Content="Remember clipboard history after restart" />
                                <CheckBox x:Name="ExpandCheck" Style="{StaticResource Switch}">
                                    <StackPanel>
                                        <TextBlock Text="Expand snippets as I type" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="Type a keyword like ;date in any app and Mirage replaces it. Typing is never stored." Style="{StaticResource Hint}" />
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Library -->
                    <StackPanel x:Name="PageLibrary" Visibility="Collapsed">
                        <TextBlock Text="Workflows" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,-6,0,14"
                                   Text="Snippets, workspaces, custom commands and AI targets live in your settings file. Edit it, save, then press Reload." />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button x:Name="EditJsonButton" Style="{StaticResource AccentButton}" Content="Edit settings.json" />
                            <Button x:Name="ReloadButton" Style="{StaticResource GhostButton}" Content="Reload" Margin="8,0,0,0" />
                            <Button x:Name="SaveWsButton" Style="{StaticResource GhostButton}" Content="Save open windows as a workspace" Margin="8,0,0,0" />
                        </StackPanel>
                        <ItemsControl x:Name="LibraryList" />
                    </StackPanel>

                    <!-- Agents -->
                    <StackPanel x:Name="PageAgents" Visibility="Collapsed">
                        <TextBlock Text="AI agents" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,-6,0,14"
                                   Text="Let AI agents on this PC open apps, manage windows, use the clipboard and more, through MCP or a small REST API. It only listens on this computer, needs your token, and you decide what each tool may do." />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="BridgeCheck" Style="{StaticResource Switch}">
                                    <StackPanel>
                                        <TextBlock Text="Allow AI agents to use Mirage" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock x:Name="BridgeState" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                </CheckBox>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Token" Style="{StaticResource Label}" Width="60" />
                                    <TextBox x:Name="TokenBox" Grid.Column="1" Style="{StaticResource GlassTextBox}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button x:Name="ShowTokenButton" Style="{StaticResource GhostButton}" Content="Show" Margin="8,0,0,0" />
                                        <Button x:Name="CopyTokenButton" Style="{StaticResource GhostButton}" Content="Copy" Margin="6,0,0,0" />
                                        <Button x:Name="NewTokenButton" Style="{StaticResource GhostButton}" Content="New token" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Port" Style="{StaticResource Label}" Width="60" />
                                    <TextBox x:Name="PortBox" Grid.Column="1" Style="{StaticResource GlassTextBox}" />
                                    <CheckBox x:Name="LogCheck" Grid.Column="2" Style="{StaticResource Switch}" Content="Keep an activity log" Margin="24,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Connect an agent" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,8" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="CopyStdioButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Copy" />
                                    <StackPanel><TextBlock Text="MCP over stdio (Claude Desktop, Cursor, VS Code, most agents)" Style="{StaticResource Label}" />
                                        <TextBlock Text="Add this to the agent's MCP servers config." Style="{StaticResource Hint}" /></StackPanel>
                                </DockPanel>
                                <TextBox x:Name="StdioSnippet" Style="{StaticResource GlassTextBox}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="CopyHttpButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Copy" />
                                    <StackPanel><TextBlock Text="MCP over HTTP (agents that take a URL and a header)" Style="{StaticResource Label}" /></StackPanel>
                                </DockPanel>
                                <TextBox x:Name="HttpSnippet" Style="{StaticResource GlassTextBox}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="CopyRestButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Copy" />
                                    <StackPanel><TextBlock Text="REST (scripts and custom bots)" Style="{StaticResource Label}" /></StackPanel>
                                </DockPanel>
                                <TextBox x:Name="RestSnippet" Style="{StaticResource GlassTextBox}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="What agents may do" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,4" />
                        <TextBlock Text="Allow runs right away. Ask shows you a prompt each time. Deny hides the tool from agents." Style="{StaticResource Hint}" Margin="0,0,0,8" />
                        <Border Style="{StaticResource Card}">
                            <ItemsControl x:Name="ToolList" />
                        </Border>

                        <DockPanel Margin="0,8,0,8">
                            <Button x:Name="ClearLogButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Clear" />
                            <TextBlock Text="Recent agent activity" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <Border Style="{StaticResource Card}">
                            <ItemsControl x:Name="ActivityList" />
                        </Border>
                    </StackPanel>

                    <!-- About -->
                    <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                        <TextBlock Text="About" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Mirage" Foreground="{StaticResource TextBrush}" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock x:Name="AboutVersion" Style="{StaticResource Hint}" Margin="0,2,0,10" />
                                <TextBlock Style="{StaticResource Hint}" Text="A keyboard-first launcher for Windows with clipboard history, snippets, workspaces, quick actions on selected text, and a local bridge for AI agents. Runs without admin rights. Free and open source under the MIT license." />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="OpenDataButton" Style="{StaticResource GhostButton}" Content="Open data folder" />
                                    <Button x:Name="OpenLogButton" Style="{StaticResource GhostButton}" Content="Open log" Margin="8,0,0,0" />
                                    <Button x:Name="RepoButton" Style="{StaticResource GhostButton}" Content="Project on GitHub" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Keyboard" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock x:Name="KeysText" Style="{StaticResource Hint}" FontSize="12.5" LineHeight="21" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
