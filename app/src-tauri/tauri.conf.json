{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mirage",
  "version": "2.0.0",
  "identifier": "com.hanialnaber.mirage",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "publisher": "Hani Al-Naber",
    "copyright": "© 2026 Hani Al-Naber. MIT License.",
    "category": "Utility",
    "shortDescription": "A desktop layer with an AI assistant",
    "longDescription": "Mirage adds a top bar, dock, command bar, voice assistant, desktop widgets, window overview, original wallpapers and an ambient screen on top of Windows and macOS.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "wallpapers/": "wallpapers/" },
    "windows": {
      "nsis": { "installMode": "currentUser", "installerIcon": "icons/icon.ico", "displayLanguageSelector": false },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    },
    "macOS": { "minimumSystemVersion": "11.0" }
  },
  "plugins": {}
}
